{
  "name": "santa-monica-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run pipeline:verify && npm run lint && npm test && npm run build && npm run test:e2e",
    "pipeline:verify": "python3 pipeline/verify_manifest.py",
    "pipeline:fixture": "python3 pipeline/build_fixture.py",
    "pipeline:ingest": "python3 pipeline/ingest_public_sources.py --download",
    "pipeline:lidar": "python3 pipeline/ingest_public_sources.py --run-lidar",
    "pipeline:lidar-features": "/opt/homebrew/bin/python3.14 pipeline/apply_lidar_features.py",
    "pipeline:shadows": "/opt/homebrew/bin/python3.14 pipeline/build_shadow_features.py",
    "pipeline:lidar-grid": "/opt/homebrew/bin/python3.14 pipeline/build_lidar_surface_grid.py"
  },
  "dependencies": {
    "mapbox-gl": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "@playwright/test": "^1.54.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
